# Copy to .streamlit/secrets.toml (git-ignored) or paste into
# Streamlit Community Cloud -> App settings -> Secrets.
# Without this file the dashboard still runs; semantic search falls back
# to offline bilingual alias matching.
[llm]
api_key = "sk-replace-me"
base_url = "https://api.openai.com/v1"
model = "gpt-4o-mini"

# OpenAI-compatible alternatives:
# DeepSeek:   base_url = "https://api.deepseek.com", model = "deepseek-chat"
# DashScope:  base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1",
#             model = "qwen-plus"
